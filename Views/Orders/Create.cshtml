@model CreateOrderViewModel
@{
    ViewData["Title"] = "Place order";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Place in-house order</h1>
    <p class="text-secondary mb-0">Select food for an active dining session. Prices are rechecked on the server.</p>
</div>

@if (Model.DiningSessions.Count == 0)
{
    <div class="alert alert-warning">No active dining session is available for this account.</div>
}
else
{
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <label asp-for="DiningSessionId" class="form-label"></label>
                <select asp-for="DiningSessionId" class="form-select">
                    @foreach (var session in Model.DiningSessions)
                    {
                        <option value="@session.DiningSessionId">@session.Label</option>
                    }
                </select>
            </div>
        </div>

        <div class="menu-order-grid">
        @for (var index = 0; index < Model.Items.Count; index++)
        {
            <input asp-for="Items[index].MenuItemId" type="hidden" />
            <article class="card border-0 shadow-sm menu-order-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <span class="text-uppercase text-secondary small">@Model.Items[index].CategoryName</span>
                            <h2 class="h5 mt-1">@Model.Items[index].Name</h2>
                        </div>
                        <strong class="text-nowrap">RM @Model.Items[index].Price.ToString("0.00")</strong>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Items[index].Quantity" class="form-label">Quantity</label>
                        <input asp-for="Items[index].Quantity" class="form-control" min="0" max="20" />
                        <span asp-validation-for="Items[index].Quantity" class="text-danger"></span>
                    </div>

                    @if (Model.Items[index].AddOns.Count > 0)
                    {
                        <fieldset class="mt-3">
                            <legend class="form-label mb-2">Add-ons</legend>
                            @foreach (var addOn in Model.Items[index].AddOns)
                            {
                                var checkboxId = $"item-{index}-addon-{addOn.AddOnId}";
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="Items[@index].SelectedAddOnIds"
                                           value="@addOn.AddOnId" id="@checkboxId"
                                           checked="@Model.Items[index].SelectedAddOnIds.Contains(addOn.AddOnId)" />
                                    <label class="form-check-label" for="@checkboxId">
                                        @addOn.Name (+RM @addOn.Price.ToString("0.00"))
                                    </label>
                                </div>
                            }
                        </fieldset>
                    }

                    <div class="mt-3">
                        <label asp-for="Items[index].SpecialRequest" class="form-label">Special request</label>
                        <input asp-for="Items[index].SpecialRequest" class="form-control" placeholder="Example: no onion" />
                        <span asp-validation-for="Items[index].SpecialRequest" class="text-danger"></span>
                    </div>
                </div>
            </article>
        }
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-primary" type="submit">Place order</button>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

