@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Orders</h1>
        <p class="text-secondary mb-0">Orders placed during active dining sessions.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Place order</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Order</th>
                <th>Table</th>
                <th>Placed</th>
                <th>Status</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            var total = order.OrderItems.Sum(item => item.LineSubtotal);
            <tr>
                <td class="fw-semibold">@order.OrderNumber</td>
                <td>@order.DiningSession.DiningTable.TableNumber</td>
                <td>@order.OrderedAt.ToString("dd MMM yyyy HH:mm")</td>
                <td><span class="status-badge status-@order.Status.ToLowerInvariant()">@order.Status</span></td>
                <td class="text-end">RM @total.ToString("0.00")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Track" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Track</a>
                    @if ((User.IsInRole("Staff") || User.IsInRole("Admin")) &&
                        order.Status is "Pending" or "Preparing")
                    {
                        <form asp-action="Cancel" asp-route-id="@order.OrderId" method="post" class="d-inline"
                              onsubmit="return confirm('Cancel @order.OrderNumber? This cannot be undone.');">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="empty-state">No orders have been placed yet.</div>
}
