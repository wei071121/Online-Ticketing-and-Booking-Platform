@model Order
@{
    ViewData["Title"] = "Order details";
    var total = Model.OrderItems.Sum(item => item.LineSubtotal);
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <span class="status-badge status-@Model.Status.ToLowerInvariant()">@Model.Status</span>
        <h1 class="h2 mt-2 mb-1">@Model.OrderNumber</h1>
        <p class="text-secondary">Table @Model.DiningSession.DiningTable.TableNumber · @Model.OrderedAt.ToString("dd MMM yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Track" asp-route-id="@Model.OrderId" class="btn btn-outline-primary">Live tracking</a>
        @if ((User.IsInRole("Staff") || User.IsInRole("Admin")) &&
            Model.Status is "Pending" or "Preparing")
        {
            <form asp-action="Cancel" asp-route-id="@Model.OrderId" method="post"
                  onsubmit="return confirm('Cancel @Model.OrderNumber? This cannot be undone.');">
                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Orders")" />
                <button type="submit" class="btn btn-outline-danger">Cancel order</button>
            </form>
        }
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @foreach (var item in Model.OrderItems)
        {
            <div class="receipt-line">
                <div>
                    <strong>@item.Quantity × @item.MenuItemName</strong>
                    @if (item.OrderItemAddOns.Count > 0)
                    {
                        <div class="text-secondary small">@string.Join(", ", item.OrderItemAddOns.Select(addOn => addOn.AddOnName))</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.SpecialRequest))
                    {
                        <div class="small">Request: @item.SpecialRequest</div>
                    }
                </div>
                <span>RM @item.LineSubtotal.ToString("0.00")</span>
            </div>
        }
        <div class="receipt-total">
            <strong>Order total</strong>
            <strong>RM @total.ToString("0.00")</strong>
        </div>
    </div>
</div>
