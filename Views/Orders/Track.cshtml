@model Order
@{
    ViewData["Title"] = "Track order";
}

<div class="tracking-panel" data-order-id="@Model.OrderId" data-status-url="@Url.Action("StatusJson", "Orders", new { id = Model.OrderId })">
    <p class="text-uppercase text-secondary small mb-2">Live kitchen status</p>
    <h1 class="h2">@Model.OrderNumber</h1>
    <div id="tracking-status" class="tracking-status">@Model.Status</div>
    <div class="tracking-steps" aria-label="Order progress">
        @foreach (var status in new[] { "Pending", "Preparing", "Ready", "Served" })
        {
            <div class="tracking-step" data-step="@status">@status</div>
        }
    </div>
    <p class="text-secondary mb-0">This page checks the latest kitchen status every five seconds.</p>
</div>

@section Scripts {
    <script src="~/js/orders/order-tracking.js" asp-append-version="true"></script>
}

