@{
    ViewData["Title"] = "Kitchen dashboard";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2 mb-1">Kitchen order dashboard</h1>
        <p class="text-secondary mb-0">Incoming orders refresh automatically every ten seconds.</p>
    </div>
    <span id="kitchen-last-updated" class="text-secondary small"></span>
</div>

<div class="kitchen-status-overview" aria-label="Live kitchen order summary">
    <article class="kitchen-status-summary kitchen-summary-pending" data-kitchen-status-count="Pending">
        <span>Pending</span><strong>0</strong><small>Waiting to start</small>
    </article>
    <article class="kitchen-status-summary kitchen-summary-preparing" data-kitchen-status-count="Preparing">
        <span>Preparing</span><strong>0</strong><small>Being prepared</small>
    </article>
    <article class="kitchen-status-summary kitchen-summary-ready" data-kitchen-status-count="Ready">
        <span>Ready</span><strong>0</strong><small>Ready for service</small>
    </article>
</div>

<form id="kitchen-token-form" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div id="kitchen-message" role="status"></div>
<div id="kitchen-board"
     data-board-url="@Url.Action("BoardPartial", "Kitchen")"
     data-update-url="@Url.Action("UpdateStatus", "Kitchen")">
    <div class="empty-state">Loading kitchen orders...</div>
</div>

@section Scripts {
    <script src="~/js/orders/kitchen-board.js" asp-append-version="true"></script>
}
