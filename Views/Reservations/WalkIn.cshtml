@model WalkInViewModel
@{
    ViewData["Title"] = "Walk-in seating";
}

<div class="walkin-shell">
    <div class="mb-4">
        <span class="eyebrow">Front-of-house operations</span>
        <h1 class="h2 mb-1">Seat a walk-in guest</h1>
        <p class="text-secondary mb-0">Select the party size, choose a currently available table and create a dining session immediately.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="WalkIn" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="DiningTableId" type="hidden" />

                <div class="row align-items-end g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Pax" class="form-label">Number of guests</label>
                        <input asp-for="Pax" type="number" min="1" max="30" class="form-control" />
                        <span asp-validation-for="Pax" class="text-danger"></span>
                    </div>
                    <div class="col-md-6"><div class="reservation-note-box">Available tables refresh automatically whenever the party size changes.</div></div>
                </div>

                <div id="availability-panel" data-url="@Url.Action("WalkInAvailabilityJson")" data-mode="walkin">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h2 class="h5 mb-1">Available tables</h2><p class="text-secondary small mb-0">Choose a table to seat this walk-in party.</p></div></div>
                    <span asp-validation-for="DiningTableId" class="text-danger d-block mb-2"></span>
                    <div id="available-tables-list" aria-live="polite"></div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">
                    <a asp-controller="Tables" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-primary" type="submit">Seat customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reservations/table-availability.js" asp-append-version="true"></script>
}
