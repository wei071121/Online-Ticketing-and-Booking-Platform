@model List<Reservation>
@{
    ViewData["Title"] = "Reservations";
    var isStaff = User.IsInRole("Staff") || User.IsInRole("Admin");
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var pendingCount = Model.Count(reservation => reservation.Status == "Pending");
    var confirmedCount = Model.Count(reservation => reservation.Status == "Confirmed");
    var todayCount = Model.Count(reservation => reservation.StartAt.Date == DateTime.Today);
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <span class="eyebrow">@(isStaff ? "Reservation operations" : "My QIGLO visits")</span>
        <h1 class="h2 mb-1">Reservations</h1>
        <p class="text-secondary mb-0">@(isStaff ? "Review bookings, prepare tables and check in arriving guests." : "Manage your table bookings and open your QR code at check-in.")</p>
    </div>
    @if (!isStaff)
    {
        <a class="btn btn-primary" asp-action="Create">Reserve a table</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["EmailStatus"] is string emailStatus)
{
    <div class="alert alert-info">@emailStatus</div>
}

@if (isStaff)
{
    <div class="reservation-stat-grid">
        <div class="reservation-stat"><span>Pending approval</span><strong>@pendingCount</strong></div>
        <div class="reservation-stat"><span>Awaiting check-in</span><strong>@confirmedCount</strong></div>
        <div class="reservation-stat"><span>Today’s bookings</span><strong>@todayCount</strong></div>
    </div>

    <div class="reservation-staff-toolbar">
        <div class="flex-grow-1">
            <label class="visually-hidden" for="reservation-search">Search reservations</label>
            <input id="reservation-search" class="form-control" type="search" placeholder="Search name, booking code or table…" />
        </div>
        <a class="btn btn-outline-primary" asp-action="CheckIn">Scan / check in</a>
        <a class="btn btn-primary" asp-action="WalkIn">Walk-in seating</a>
    </div>

    var statuses = new[] { "All", "Pending", "Confirmed", "Rejected", "Cancelled", "CheckedIn", "Completed" };
    <ul class="nav nav-pills mb-3">
        @foreach (var status in statuses)
        {
            var active = (string)ViewBag.StatusFilter == status ? "active" : "";
            <li class="nav-item"><a class="nav-link @active" asp-action="Index" asp-route-status="@status">@status</a></li>
        }
    </ul>
}

@if (Model.Count == 0)
{
    <div class="empty-state">No reservations to show.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white" id="reservation-table">
            <thead>
                <tr>
                    @if (isStaff) { <th>Customer</th> }
                    <th>Table</th>
                    <th>Date &amp; time</th>
                    <th>Pax</th>
                    <th>Booking code</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var reservation in Model)
            {
                var searchText = $"{reservation.Customer?.FullName} {reservation.BookingCode} {reservation.DiningTable?.TableNumber}".ToLowerInvariant();
                <tr data-reservation-search="@searchText">
                    @if (isStaff) { <td>@reservation.Customer?.FullName</td> }
                    <td>
                        @if (!isStaff && reservation.Status == "Pending")
                        {
                            <span class="table-assignment-pending">Assigned after confirmation</span>
                        }
                        else
                        {
                            @(reservation.DiningTable?.TableNumber ?? "-")
                        }
                    </td>
                    <td>@reservation.StartAt.ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@reservation.Pax</td>
                    <td>
                        <span class="booking-code-box">@reservation.BookingCode</span>
                        @if (!isStaff && reservation.Status is "Pending" or "Confirmed")
                        {
                            <a class="small d-block mt-1" asp-action="Qr" asp-route-id="@reservation.ReservationId">Open QR booking</a>
                        }
                    </td>
                    <td><span class="status-badge status-@reservation.Status.ToLowerInvariant()">@reservation.Status</span></td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end flex-wrap gap-2">
                            @if (isStaff && reservation.Status == "Pending")
                            {
                                <form asp-action="Approve" method="post">
                                    <input type="hidden" name="id" value="@reservation.ReservationId" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button class="btn btn-sm btn-primary" type="submit">Approve</button>
                                </form>
                                <form asp-action="Reject" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="Id" value="@reservation.ReservationId" />
                                    <input type="hidden" name="ReturnUrl" value="@currentPath" />
                                    <input type="text" name="Reason" maxlength="250" class="form-control form-control-sm" placeholder="Reason (optional)" aria-label="Rejection reason" style="max-width:160px" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                                </form>
                            }
                            @if (reservation.Status is "Pending" or "Confirmed")
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this reservation?');">
                                    <input type="hidden" name="id" value="@reservation.ReservationId" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @if (isStaff)
    {
        <script>
            document.getElementById('reservation-search')?.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                document.querySelectorAll('#reservation-table tbody tr').forEach(row => {
                    row.classList.toggle('reservation-row-hidden', query && !row.dataset.reservationSearch.includes(query));
                });
            });
        </script>
    }
}
