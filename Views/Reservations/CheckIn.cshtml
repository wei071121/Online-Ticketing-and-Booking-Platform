@model CheckInViewModel
@{
    ViewData["Title"] = "Guest check-in";
    var confirmedReservations = ViewBag.ConfirmedReservations as List<Reservation> ?? [];
}

<div class="checkin-shell">
    <div class="mb-4">
        <span class="eyebrow">Front-of-house operations</span>
        <h1 class="h2 mb-1">Guest check-in</h1>
        <p class="text-secondary mb-0">Enter a booking code or scan the guest’s QR code to start their dining session.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="checkin-grid">
        <section class="card checkin-card border-0">
            <div class="card-body p-4">
                <span class="eyebrow">Option 1</span>
                <h2 class="h4">Enter booking code</h2>
                <p class="text-secondary small">Use the code shown on the customer’s booking confirmation.</p>
                <form asp-action="CheckIn" method="post" id="check-in-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="BookingCode" class="form-label"></label>
                        <input asp-for="BookingCode" class="form-control" id="BookingCode" autofocus placeholder="For example, QIGLO-123456" />
                        <span asp-validation-for="BookingCode" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Check in guest</button>
                </form>
            </div>
        </section>

        <section class="scanner-panel">
            <span class="eyebrow">Option 2</span>
            <h2 class="h4">Scan booking QR</h2>
            <p class="text-secondary small">Use this device’s camera. The image remains on this device and is not uploaded.</p>
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button id="start-qr-scan" class="btn btn-primary" type="button">Start camera</button>
                <button id="stop-qr-scan" class="btn btn-outline-secondary d-none" type="button">Stop camera</button>
            </div>
            <div id="qr-scanner-panel" class="d-none">
                <video id="qr-video" class="w-100 rounded border bg-dark" style="max-height:320px" muted playsinline></video>
                <div id="qr-scan-status" class="small text-secondary mt-2" role="status">Point the camera at a QIGLO QR code.</div>
            </div>
        </section>
    </div>

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div><span class="eyebrow">Today’s arrivals</span><h2 class="h4 mb-0">Awaiting check-in</h2></div>
        <a asp-action="WalkIn" class="btn btn-outline-primary">Seat a walk-in</a>
    </div>

    @if (confirmedReservations.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white">
                <thead><tr><th>Customer</th><th>Table</th><th>Date &amp; time</th><th>Booking code</th><th class="text-end"></th></tr></thead>
                <tbody>
                @foreach (var reservation in confirmedReservations)
                {
                    <tr>
                        <td>@reservation.Customer?.FullName</td>
                        <td>@(reservation.DiningTable?.TableNumber ?? "-")</td>
                        <td>@reservation.StartAt.ToString("dd MMM yyyy, HH:mm")</td>
                        <td><span class="booking-code-box">@reservation.BookingCode</span></td>
                        <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary use-code-button" data-code="@reservation.BookingCode">Use code</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">No confirmed reservations are waiting for check-in.</div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reservations/qr-scanner.js" asp-append-version="true"></script>
}
