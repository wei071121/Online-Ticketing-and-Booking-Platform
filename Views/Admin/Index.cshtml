@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div><span class="eyebrow text-success">Management overview</span><h1 class="h3 mb-0">Admin Dashboard</h1></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Users">Manage Users</a><a class="btn btn-primary" asp-action="Reports">Full Reports</a></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="card metric-card border-0 shadow-sm"><div class="card-body"><small>Active users</small><div class="h3">@Model.ActiveUsers</div></div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card border-0 shadow-sm"><div class="card-body"><small>Active tables</small><div class="h3">@Model.ActiveTables</div></div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card border-0 shadow-sm"><div class="card-body"><small>Pending bookings</small><div class="h3">@Model.PendingReservations</div></div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card border-0 shadow-sm"><div class="card-body"><small>Open orders</small><div class="h3">@Model.OpenOrders</div></div></div></div>
    <div class="col-12 col-lg"><div class="card metric-card border-0 shadow-sm"><div class="card-body"><small>Today revenue</small><div class="h3">RM @Model.TodayRevenue.ToString("N2")</div></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Paid sales · last 7 days</h2><canvas id="sales-chart" height="230" aria-label="Seven day sales bar chart"></canvas></div></div></div>
    <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Popular items</h2><canvas id="popular-chart" height="230" aria-label="Popular menu items chart"></canvas></div></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between p-3 border-bottom"><h2 class="h5 mb-0">Recent account activity</h2><a asp-action="Audit">View all</a></div>
        <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>
        @foreach (var log in Model.RecentAuditLogs)
        {
            <tr><td class="text-nowrap">@log.CreatedAt.ToString("dd MMM HH:mm")</td><td>@(log.User?.Email ?? "System")</td><td>@log.Action</td><td>@log.Details</td></tr>
        }
        </tbody></table></div>
    </div>
</div>

@section Scripts {
    <script>
        window.qigloDashboard = {
            sales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySales.Select(x => new { label = x.Date.ToString("dd MMM"), value = x.Revenue }))),
            popular: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PopularItems.Select(x => new { label = x.Name, value = x.Quantity })))
        };
    </script>
    <script src="~/js/admin/admin-dashboard.js" asp-append-version="true"></script>
}
