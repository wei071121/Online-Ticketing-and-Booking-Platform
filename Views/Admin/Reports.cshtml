@model AdminReportViewModel
@{ ViewData["Title"] = "Management Reports"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h1 class="h3 mb-0">Management Reports</h1><p class="text-secondary mb-0">Sales, orders, users, bookings and popular food.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">Dashboard</a><a class="btn btn-outline-secondary" asp-action="Audit">Audit Log</a></div></div>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Paid revenue</small><div class="h4">RM @Model.PaidRevenue.ToString("N2")</div></div></div></div>
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Transactions</small><div class="h4">@Model.PaidTransactions</div></div></div></div>
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Orders</small><div class="h4">@Model.OpenOrders / @Model.TotalOrders</div></div></div></div>
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Active users</small><div class="h4">@Model.ActiveUsers / @Model.TotalUsers</div></div></div></div>
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Reservations</small><div class="h4">@Model.TotalReservations</div></div></div></div>
    <div class="col-md-4 col-xl-2"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small>Confirmed/served</small><div class="h4">@Model.ConfirmedReservations</div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Daily paid sales · latest 14 days</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date</th><th>Transactions</th><th class="text-end">Revenue</th></tr></thead><tbody>@if (!Model.DailySales.Any()) { <tr><td colspan="3" class="text-secondary">No completed payments yet.</td></tr> } @foreach (var day in Model.DailySales) { <tr><td>@day.Date.ToString("dd MMM yyyy")</td><td>@day.Transactions</td><td class="text-end">RM @day.Revenue.ToString("N2")</td></tr> }</tbody></table></div></div></div></div>
    <div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Popular items by ordered quantity</h2><ol class="list-group list-group-numbered list-group-flush">@if (!Model.PopularItems.Any()) { <li class="list-group-item text-secondary">No order data yet.</li> } @foreach (var item in Model.PopularItems) { <li class="list-group-item d-flex justify-content-between"><span>@item.Name</span><strong>@item.Quantity</strong></li> }</ol></div></div></div>
</div>
