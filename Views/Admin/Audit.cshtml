@model IEnumerable<AuditLog>
@{ ViewData["Title"] = "Audit Log"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Audit Log</h1><a class="btn btn-outline-secondary" asp-action="Reports">Reports</a></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="text-nowrap">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</td><td>@(item.User?.Email ?? "Unknown")</td><td>@item.Action</td><td>@item.Details</td></tr> }</tbody></table></div></div></div>
