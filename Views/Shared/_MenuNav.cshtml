@{
    var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<nav class="menu-local-nav mb-4" aria-label="Menu and cart navigation">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a class="menu-local-brand" asp-controller="Menu" asp-action="Index">QIGLO Menu</a>
        <a class="btn btn-sm btn-outline-dark" asp-controller="Menu" asp-action="Index">Menu</a>

        @if (User.IsInRole("Customer"))
        {
            <a class="btn btn-sm btn-outline-dark" asp-controller="Cart" asp-action="Index">Cart</a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-sm btn-outline-dark"
               asp-controller="Account"
               asp-action="Login"
               asp-route-returnUrl="/Menu">Login to Order</a>
        }

        @if (User.IsInRole("Admin"))
        {
            <span class="menu-nav-divider"></span>
            <a class="btn btn-sm btn-outline-dark" asp-controller="AdminMenuItems" asp-action="Index">Manage Menu</a>
            <a class="btn btn-sm btn-outline-dark" asp-controller="AdminCategories" asp-action="Index">Categories</a>
        }

        <div class="ms-auto d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="menu-role-badge">@currentRole</span>
            }
            else
            {
                <span class="menu-role-badge">Guest Preview</span>
            }
            <a class="btn btn-sm btn-light menu-home-btn" asp-controller="Home" asp-action="Index">Home</a>
        </div>
    </div>
</nav>
