@model QigloRestaurant.Web.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<partial name="_MenuAssets" />
<partial name="_MenuNav" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <section class="menu-cart-hero mb-4">
        <div>
            <span class="menu-kicker">YOUR ORDER</span>
            <h1>Shopping Cart</h1>
            <p>Dining Session #@Model.DiningSessionId · Review quantities, add-ons and special instructions before ordering.</p>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-light">+ Add More Food</a>
    </section>

    @if (Model.Lines.Count == 0)
    {
        <div class="card menu-surface menu-empty p-5 text-center">
            <div class="menu-empty-icon">🛒</div>
            <h2 class="h4">Your cart is empty.</h2>
            <p class="text-muted">Browse the menu, choose a dish and press Add to Cart.</p>
            <a asp-controller="Menu" asp-action="Index" class="btn btn-dark mx-auto px-4">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                @foreach (var line in Model.Lines)
                {
                    <article class="card menu-surface menu-cart-line mb-3">
                        <div class="card-body p-3 p-md-4">
                            <div class="row g-3 align-items-center">
                                <div class="col-4 col-md-2">
                                    @if (!string.IsNullOrWhiteSpace(line.Photo))
                                    {
                                        <img src="@line.Photo"
                                             class="img-fluid rounded cart-thumb"
                                             alt="@line.MenuItemName"
                                             onerror="this.onerror=null;this.src='/images/menu-placeholder.svg';" />
                                    }
                                    else
                                    {
                                        <img src="~/images/menu-placeholder.svg" class="img-fluid rounded cart-thumb" alt="No food photo" />
                                    }
                                </div>

                                <div class="col-8 col-md-4">
                                    <h2 class="h5 mb-1">@line.MenuItemName</h2>
                                    <div class="menu-line-price">RM @line.UnitPrice.ToString("0.00") each</div>
                                    @if (line.AddOns.Count > 0)
                                    {
                                        <div class="small text-muted mt-2">
                                            @foreach (var a in line.AddOns)
                                            {
                                                <div>+ @a.Name (@(a.ExtraPrice == 0 ? "Free" : $"RM {a.ExtraPrice:0.00}"))</div>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(line.SpecialInstructions))
                                    {
                                        <div class="menu-cart-note mt-2"><strong>Note:</strong> @line.SpecialInstructions</div>
                                    }
                                </div>

                                <div class="col-md-4">
                                    <form asp-action="Update" method="post" class="menu-quantity-form">
                                        <input type="hidden" name="LineKey" value="@line.LineKey" />
                                        <label class="form-label small">Quantity</label>
                                        <div class="d-flex gap-2">
                                            <input type="number" name="Quantity" min="1" max="20" value="@line.Quantity" class="form-control" />
                                            <button type="submit" class="btn btn-outline-dark">Update</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="col-md-2 text-md-end">
                                    <div class="small text-muted">Line Total</div>
                                    <div class="fw-bold fs-5 mb-2">RM @line.LineTotal.ToString("0.00")</div>
                                    <form asp-action="Remove" method="post" onsubmit="return confirm('Remove this item from the cart?');">
                                        <input type="hidden" name="lineKey" value="@line.LineKey" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="col-lg-4">
                <div class="card menu-surface menu-order-summary position-sticky" style="top:1rem">
                    <div class="card-body p-4">
                        <span class="menu-section-kicker">ORDER SUMMARY</span>
                        <h2 class="h4 mb-4">Ready to place order?</h2>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Quantity</span>
                            <strong>@Model.TotalQuantity</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Customized Lines</span>
                            <strong>@Model.Lines.Count</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-end menu-cart-grand-total">
                            <span>Total</span>
                            <strong>RM @Model.GrandTotal.ToString("0.00")</strong>
                        </div>

                        <form asp-action="Checkout" method="post" class="d-grid mt-4">
                            <button type="submit" class="btn btn-dark btn-lg">Proceed to Order</button>
                        </form>

                        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-dark w-100 mt-2">Continue Shopping</a>

                        <form asp-action="Clear" method="post" class="d-grid mt-2" onsubmit="return confirm('Clear the entire cart?');">
                            <button type="submit" class="btn btn-outline-danger">Clear Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
