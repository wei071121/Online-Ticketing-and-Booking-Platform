@{
    ViewData["Title"] = "About QIGLO";
}

<section class="about-hero full-bleed-section">
    <div class="about-hero-copy">
        <span class="hero-overline">OUR STORY</span>
        <h1>Made for good<br /><em>company.</em></h1>
        <p>QIGLO is a place for the familiar, the delicious and the moments worth lingering over.</p>
    </div>
</section>

<div class="container-xxl about-page">
    <section class="about-introduction">
        <div class="about-welcome-display" aria-label="Welcome to QIGLO">
            <span>WELCOME</span>
            <span>TO</span>
            <span>QIGLO</span>
        </div>
        <div>
            <h2>We believe the best meals leave you feeling more at home than when you arrived.</h2>
            <p>QIGLO Restaurant brings together satisfying western favourites, fresh ingredients and friendly service in one easy-going dining space. Whether you are catching up with friends, celebrating a small win or simply craving a comforting plate, we make room for it.</p>
        </div>
    </section>

    <section class="about-photo-grid" aria-label="A selection of QIGLO dishes">
        <div class="about-photo-grid-main" role="img" aria-label="QIGLO pasta dish"></div>
        <div class="about-photo-grid-top" role="img" aria-label="QIGLO grilled chicken dish"></div>
        <div class="about-photo-grid-bottom" role="img" aria-label="QIGLO dessert dish"></div>
    </section>

    <section class="about-values">
        <div><span>01</span><h2>Fresh, always.</h2><p>We prepare with care and serve every dish when it is at its best.</p></div>
        <div><span>02</span><h2>Easy together.</h2><p>From booking to billing, QIGLO makes dining smooth for guests and our team.</p></div>
        <div><span>03</span><h2>Warm by nature.</h2><p>Good service is not an extra. It is part of every meal we share.</p></div>
    </section>

    <section class="about-reserve-panel full-bleed-section">
        <div>
            <span class="hero-overline">YOUR TABLE AWAITS</span>
            <h2>Bring your appetite.<br />We will handle the rest.</h2>
        </div>
        @if (User.IsInRole("Customer"))
        {
            <a asp-controller="Reservations" asp-action="Create" class="hero-action hero-action-primary">Reserve a table <span aria-hidden="true">↗</span></a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Reservations/Create" class="hero-action hero-action-primary">Reserve a table <span aria-hidden="true">↗</span></a>
        }
        else
        {
            <a asp-controller="Menu" asp-action="Index" class="hero-action hero-action-primary">Explore the menu <span aria-hidden="true">→</span></a>
        }
    </section>
</div>
