@model QigloRestaurant.Web.ViewModels.MenuCatalogViewModel

<section>
    <div class="d-flex justify-content-between align-items-end mb-3 gap-3 flex-wrap">
        <div>
            <span class="menu-section-kicker">FULL CATALOG</span>
            <h2 class="menu-section-title mb-0">Our Menu</h2>
        </div>
        <span class="menu-result-count">@Model.Items.Count item(s)</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h4>No matching food found.</h4>
            <p class="mb-0">Try another keyword or choose a different category.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 col-xl-4">
                    <partial name="_MenuCard" model="item" />
                </div>
            }
        </div>
    }
</section>
