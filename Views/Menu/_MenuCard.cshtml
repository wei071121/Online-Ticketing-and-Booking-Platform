@model QigloRestaurant.Web.ViewModels.MenuCardViewModel

<article class="card h-100 menu-card menu-surface">
    <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.MenuItemId" class="menu-card-photo-link" aria-label="View @Model.Name">
        @if (!string.IsNullOrWhiteSpace(Model.PrimaryPhoto))
        {
            <img src="@Model.PrimaryPhoto"
                 class="card-img-top menu-card-img"
                 alt="@Model.Name"
                 loading="lazy"
                 onerror="this.onerror=null;this.src='/images/menu-placeholder.svg';" />
        }
        else
        {
            <img src="~/images/menu-placeholder.svg" class="card-img-top menu-card-img" alt="@Model.Name placeholder" />
        }
        <span class="menu-photo-overlay">View Details</span>
    </a>

    <div class="card-body d-flex flex-column p-4">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <span class="menu-card-category">@Model.CategoryName</span>
                <h3 class="h5 card-title mt-1 mb-1">@Model.Name</h3>
            </div>
            <div class="fw-bold text-nowrap menu-price">RM @Model.Price.ToString("0.00")</div>
        </div>

        <div class="d-flex gap-2 flex-wrap mb-2">
            @if (Model.PopularQuantity > 0)
            {
                <span class="menu-popular-badge">🔥 @Model.PopularQuantity ordered</span>
            }
            else if (Model.IsRecommended)
            {
                <span class="menu-recommended-badge">★ Recommended</span>
            }
            @if (!Model.IsAvailable)
            {
                <span class="menu-soldout-badge">Sold Out</span>
            }
        </div>

        <p class="card-text text-muted flex-grow-1 menu-card-description">@Model.Description</p>

        @if (Model.IsAvailable)
        {
            <div class="d-grid gap-2 mt-2">
                <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.MenuItemId" class="btn btn-dark">View & Customize</a>

                @if (User.IsInRole("Customer"))
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-grid">
                        <input type="hidden" name="MenuItemId" value="@Model.MenuItemId" />
                        <input type="hidden" name="Quantity" value="1" />
                        <button type="submit" class="btn btn-outline-dark">+ Quick Add</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Menu", new { id = Model.MenuItemId })"
                       class="btn btn-outline-dark">Login to Order</a>
                }
            </div>
        }
        else
        {
            <button type="button" class="btn btn-secondary w-100 mt-2" disabled>Currently Sold Out</button>
        }
    </div>
</article>
