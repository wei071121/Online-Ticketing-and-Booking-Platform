@model QigloRestaurant.Web.ViewModels.MenuCatalogViewModel
@{
    ViewData["Title"] = "Menu";
}

<partial name="_MenuAssets" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <section class="menu-hero mb-4">
        <div class="menu-hero-copy">
            <span class="menu-kicker">QIGLO WESTERN KITCHEN</span>
            <h1>Choose your favourite meal.</h1>
            <p>Browse the full menu, view food photos, customize add-ons and place your in-house order.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (User.IsInRole("Customer"))
                {
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-light">View My Cart</a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminMenuItems" asp-action="Index" class="btn btn-light">Manage Menu</a>
                    <a asp-controller="AdminCategories" asp-action="Index" class="btn btn-outline-light">Categories</a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Menu" class="btn btn-light">Login to Order</a>
                }
            </div>
        </div>
    </section>

    <section class="menu-filter-panel mb-4">
        <form id="menu-filter-form" asp-controller="Menu" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-lg-6">
                <label class="visually-hidden" for="menu-search">Search menu</label>
                <div class="menu-search-box">
                    <span aria-hidden="true">⌕</span>
                    <input id="menu-search" name="search" value="@Model.Search" class="form-control form-control-lg" placeholder="Search chicken, pasta, burger..." />
                </div>
            </div>
            <div class="col-lg-4">
                <label class="visually-hidden" for="menu-category">Category</label>
                <select id="menu-category" name="categoryId" class="form-select form-select-lg">
                    @if (!Model.CategoryId.HasValue)
                    {
                        <option value="" selected>All categories</option>
                    }
                    else
                    {
                        <option value="">All categories</option>
                    }
                    @foreach (var c in Model.Categories)
                    {
                        if (Model.CategoryId == c.CategoryId)
                        {
                            <option value="@c.CategoryId" selected>@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.CategoryId">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-2 d-grid">
                <button id="menu-clear" type="button" class="btn btn-outline-dark btn-lg">Clear</button>
            </div>
        </form>

        <div class="menu-category-chips mt-3" aria-label="Quick category filters">
            <button type="button" class="menu-chip @(Model.CategoryId.HasValue ? "" : "active")" data-category-id="">All</button>
            @foreach (var c in Model.Categories)
            {
                <button type="button"
                        class="menu-chip @(Model.CategoryId == c.CategoryId ? "active" : "")"
                        data-category-id="@c.CategoryId">@c.Name</button>
            }
        </div>
    </section>

    <div id="menu-results">
        <partial name="_MenuResults" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/menu-catalog.js" asp-append-version="true"></script>
}
