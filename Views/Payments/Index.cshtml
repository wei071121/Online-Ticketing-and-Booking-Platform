@model IEnumerable<DiningSession>
@{
    var isCustomer = User.IsInRole("Customer");
    ViewData["Title"] = isCustomer ? "My bills & receipts" : "Billing";
}

<div class="mb-4">
    <span class="eyebrow">@(isCustomer ? "Your QIGLO account" : "Service operations")</span>
    <h1 class="h2 mb-1">@(isCustomer ? "My bills & receipts" : "Dining session billing")</h1>
    <p class="text-secondary mb-0">@(isCustomer ? "Follow your payment status and open completed receipts." : "One final bill combines all non-cancelled orders in the dining session.")</p>
</div>

@if (isCustomer)
{
    <div class="customer-payment-guide mb-4">
        <div class="customer-payment-guide-icon" aria-hidden="true">RM</div>
        <div>
            <h2>Pay at the counter</h2>
            <p>When you are ready, tell a staff member your table number. Staff will prepare the final bill and accept cash, card or e-wallet payment at the counter.</p>
            <small>Your digital receipt appears here immediately after payment is completed.</small>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">@(isCustomer ? "No dining bills yet. Your bill will appear after staff checks you in." : "No dining sessions are ready for billing.")</div>
}
else
{
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Session</th>
                <th>Table</th>
                @if (!isCustomer) { <th>Customer</th> }
                <th>Orders</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var session in Model)
        {
            <tr>
                <td>#@session.DiningSessionId</td>
                <td>@session.DiningTable.TableNumber</td>
                @if (!isCustomer) { <td>@(session.Customer?.FullName ?? "Walk-in")</td> }
                <td>@session.Orders.Count</td>
                <td><span class="status-badge status-@session.Status.ToLowerInvariant()">@session.Status</span></td>
                <td class="text-end">
                    @if (session.Payment is not null)
                    {
                        <a asp-action="Details" asp-route-id="@session.Payment.PaymentId" class="btn btn-sm btn-outline-primary">Receipt</a>
                    }
                    else if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" asp-route-diningSessionId="@session.DiningSessionId" class="btn btn-sm btn-primary">Prepare bill</a>
                    }
                    else
                    {
                        <span class="payment-awaiting-label">Awaiting payment · Pay at counter</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
}
