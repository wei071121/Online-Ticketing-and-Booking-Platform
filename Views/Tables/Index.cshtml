@model List<DiningTable>
@{
    ViewData["Title"] = "Tables";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2 mb-1">Restaurant tables</h1>
        <p class="text-secondary mb-0">Add, edit or deactivate dining tables.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add table</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">No tables have been added yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white shadow-sm">
            <thead>
                <tr>
                    <th>Table</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var table in Model)
            {
                <tr>
                    <td><strong>@table.TableNumber</strong></td>
                    <td>@table.Capacity guest(s)</td>
                    <td><span class="status-badge status-@table.Status.ToLowerInvariant()">@table.Status</span></td>
                    <td>@(table.IsActive ? "Yes" : "No")</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@table.DiningTableId">Edit</a>
                            <form asp-action="Delete" asp-route-id="@table.DiningTableId" method="post"
                                  onsubmit="return confirm('Remove table @table.TableNumber?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
