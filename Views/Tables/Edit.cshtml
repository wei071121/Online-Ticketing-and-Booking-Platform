@model TableFormViewModel
@{
    ViewData["Title"] = "Edit table";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">Edit table</h1>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="DiningTableId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TableNumber" class="form-label"></label>
                        <input asp-for="TableNumber" class="form-control" placeholder="e.g. T06" />
                        <span asp-validation-for="TableNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" type="number" min="1" max="30" class="form-control" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Available">Available</option>
                            @if (Model.Status == "Occupied")
                            {
                                <option value="Occupied">Occupied (controlled by active session)</option>
                            }
                            <option value="Unavailable">Unavailable</option>
                        </select>
                        <div class="form-text">Occupied status cannot be set manually and cannot be cleared while a session is active.</div>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
