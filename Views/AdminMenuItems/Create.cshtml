@model QigloRestaurant.Web.ViewModels.MenuItemFormViewModel
@{
    ViewData["Title"] = "Add Menu Item";
}

<partial name="_MenuAssets" />
<partial name="_MenuNav" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <div class="menu-page-header d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <span class="menu-section-kicker">MENU MANAGEMENT</span>
            <h1 class="h2 mb-1">Add Menu Item</h1>
            <p class="text-muted mb-0">Create a new food item with photos and optional add-ons.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark">← Back to Menu Management</a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card menu-surface menu-form-card p-4 mt-4">
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 justify-content-end mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-dark px-4">Save Menu Item</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-menu-item.js" asp-append-version="true"></script>
}
