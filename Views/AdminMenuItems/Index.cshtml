@model IEnumerable<QigloRestaurant.Models.Entities.MenuItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Menu Management";
    var categories = ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedCategoryId = ViewBag.CategoryId?.ToString();
}

<partial name="_MenuAssets" />
<partial name="_MenuNav" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <section class="menu-admin-hero mb-4">
        <div>
            <span class="menu-kicker">MENU & CART ADMIN</span>
            <h1>Menu Management</h1>
            <p>Manage food items, prices, availability, photos and customization options.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-light">Preview Customer Menu</a>
            <a asp-action="Create" class="btn btn-light">+ Add Menu Item</a>
        </div>
    </section>

    <form method="get" class="row g-2 mb-3 menu-filter-panel">
        <div class="col-md-5">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search food name or description..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                @if (string.IsNullOrWhiteSpace(selectedCategoryId))
                {
                    <option value="" selected>All categories</option>
                }
                else
                {
                    <option value="">All categories</option>
                }
                @foreach (var c in categories)
                {
                    if (selectedCategoryId == c.Value)
                    {
                        <option value="@c.Value" selected>@c.Text</option>
                    }
                    else
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-outline-dark">Filter</button>
        </div>
    </form>

    <div class="card menu-surface menu-admin-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Food</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Photos</th>
                        <th>Add-ons</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var photo = item.Photos.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).FirstOrDefault();
                        <tr>
                            <td>
                                @if (photo is not null)
                                {
                                    <img src="@photo.FileName"
                                         class="menu-admin-thumb"
                                         alt="@item.Name"
                                         onerror="this.onerror=null;this.src='/images/menu-placeholder.svg';" />
                                }
                                else
                                {
                                    <img src="~/images/menu-placeholder.svg" class="menu-admin-thumb" alt="No food photo" />
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                <small class="text-muted menu-admin-description">@item.Description</small>
                            </td>
                            <td>@item.Category?.Name</td>
                            <td class="text-nowrap">RM @item.Price.ToString("0.00")</td>
                            <td>@item.Photos.Count</td>
                            <td>@item.MenuItemAddOns.Count</td>
                            <td>
                                <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                    @(item.IsAvailable ? "Available" : "Sold Out")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end flex-wrap gap-1">
                                    <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.MenuItemId" class="btn btn-sm btn-outline-secondary">Preview</a>
                                    <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn btn-sm btn-outline-dark">Edit</a>
                                    <form asp-action="ToggleAvailability" asp-route-id="@item.MenuItemId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-warning" : "btn-outline-success")">
                                            @(item.IsAvailable ? "Mark Sold Out" : "Make Available")
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.MenuItemId" method="post" class="d-inline" onsubmit="return confirm('Delete this menu item?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
