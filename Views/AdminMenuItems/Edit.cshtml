@model QigloRestaurant.Web.ViewModels.MenuItemFormViewModel
@{
    ViewData["Title"] = "Edit Menu Item";
}

<partial name="_MenuAssets" />
<partial name="_MenuNav" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <div class="menu-page-header d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <span class="menu-section-kicker">MENU MANAGEMENT</span>
            <h1 class="h2 mb-1">Edit @Model.Name</h1>
            <p class="text-muted mb-0">Update food information, add-ons and uploaded photos.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.MenuItemId" class="btn btn-outline-dark">Preview</a>
            <a asp-action="Index" class="btn btn-outline-dark">← Back</a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.MenuItemId" method="post" enctype="multipart/form-data" class="card menu-surface menu-form-card p-4 mt-4">
        <input asp-for="MenuItemId" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 justify-content-end mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-dark px-4">Save Changes</button>
        </div>
    </form>

    <section class="card menu-surface p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
            <div>
                <span class="menu-section-kicker">PHOTO MANAGEMENT</span>
                <h2 class="h5 mb-0">Existing Photos</h2>
            </div>
            <span class="menu-result-count">@Model.ExistingPhotos.Count photo(s)</span>
        </div>

        @if (Model.ExistingPhotos.Count == 0)
        {
            <div class="empty-state py-4">No photos yet. Use the Food Photos field above to upload images.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var photo in Model.ExistingPhotos)
                {
                    <div class="col-sm-6 col-lg-3">
                        <div class="menu-photo-tile rounded p-2 h-100">
                            <img src="@photo.FileName"
                                 class="menu-existing-photo rounded mb-2"
                                 alt="Food photo"
                                 onerror="this.onerror=null;this.src='/images/menu-placeholder.svg';" />
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                @if (photo.IsPrimary)
                                {
                                    <span class="badge bg-dark">Primary Photo</span>
                                }
                                else
                                {
                                    <span class="small text-muted">Gallery Photo</span>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                @if (!photo.IsPrimary)
                                {
                                    <form asp-action="SetPrimaryPhoto" method="post">
                                        <input type="hidden" name="photoId" value="@photo.MenuItemPhotoId" />
                                        <button type="submit" class="btn btn-sm btn-outline-dark w-100">Set as Primary</button>
                                    </form>
                                }
                                <form asp-action="DeletePhoto" method="post" onsubmit="return confirm('Delete this photo?');">
                                    <input type="hidden" name="photoId" value="@photo.MenuItemPhotoId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete Photo</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-menu-item.js" asp-append-version="true"></script>
}
