@model IEnumerable<QigloRestaurant.Models.Entities.Category>
@{
    ViewData["Title"] = "Category Management";
}

<partial name="_MenuAssets" />
<partial name="_MenuNav" />

<div class="menu-page">
    <partial name="_MenuAlerts" />

    <section class="menu-admin-hero mb-4">
        <div>
            <span class="menu-kicker">MENU & CART ADMIN</span>
            <h1>Category Management</h1>
            <p>Organize the western menu into clear food categories for customer filtering.</p>
        </div>
        <a asp-action="Create" class="btn btn-light">+ Add Category</a>
    </section>

    <div class="card menu-surface menu-admin-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Menu Items</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.MenuItems.Count</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-dark">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
